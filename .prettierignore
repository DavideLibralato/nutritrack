# cartella ("supabase" escluderebbe anche src/lib/supabase), con "/"
# solo nella radice del progetto.

# Generati o di terzi
/.next
node_modules
package-lock.json
next-env.d.ts
/.claude
/.impeccable
/public
/supabase

