# il suo rientro (si rigenera, Prettier lo riformatterebbe ogni volta);
# docs/catalogo/*.json sono la lista approvata e le correzioni, da
# lasciare come sono state scritte.
/src/lib/catalogo/*.json
/docs/catalogo/*.json

